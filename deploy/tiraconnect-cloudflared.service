# ~/.config/systemd/user/tiraconnect-cloudflared.service
[Unit]
Description=TiraConnect — túnel Cloudflare (tiraconnect / tiraconnect-admin .cursar.space)
BindsTo=tiraconnect.service
After=tiraconnect.service

[Service]
Type=simple
ExecStart=/usr/bin/env cloudflared tunnel --no-autoupdate --config %h/.cloudflared/tiraconnect.yml run tiraconnect
Restart=on-failure
RestartSec=5

[Install]
WantedBy=tiraconnect.service
