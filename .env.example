# ---- TiraConnect — copie para .env e ajuste ----
# Porta local (no server: faixa 3000–3199; 3120 reservada para o TiraConnect)
PORT=3120
HOST=127.0.0.1

# Onde ficam banco e uploads (no server: HD de backup)
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Hostnames que abrem o Portal da Coordenação na raiz "/".
# Qualquer outro host abre o Portal do Aluno. Em qualquer host, /coordenacao abre o admin.
ADMIN_HOSTS=tiraconnect-admin.cursar.space,localhost-admin

# true quando servido por HTTPS (atrás do túnel Cloudflare)
COOKIE_SECURE=false
SESSION_HOURS=12

# Origens aceitas em requisições que alteram dados (proteção CSRF). Vazio = mesmo host.
ALLOWED_ORIGINS=https://tiraconnect.cursar.space,https://tiraconnect-admin.cursar.space

# Limite de upload por arquivo (MB)
MAX_UPLOAD_MB=25

# Usuário inicial do portal da coordenação (criado só se ainda não existir)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_NAME="Coordenação TiraConnect"

# Dados de demonstração (turmas, alunos e comunicados de exemplo)
SEED_DEMO=true
SEED_DEMO_STUDENT_PASSWORD=aluno123

# Backup
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
